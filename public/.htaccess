# tayseerlaz.com on HostGator (Apache). Static Vite build, copied into public_html as-is.
Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# One canonical origin: https, no www.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://tayseerlaz.com%{REQUEST_URI} [R=301,L]

# The previous site had path routes that Google indexed. Case studies now open on hash routes.
RewriteRule ^work/(omnisign|bsheel|ievents)/?$ /#work/$1 [R=301,NE,L]
RewriteRule ^work/dyafa/?$ /#work/ievents [R=301,NE,L]
RewriteRule ^work/real-estate/?$ /#work/bsheel [R=301,NE,L]
RewriteRule ^work(/.*)?$ /#work [R=301,NE,L]

# Unknown paths render the site but keep a real 404 status.
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  # Always revalidate the page so a redeploy shows up immediately.
  <FilesMatch "\.(html|xml|txt|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Hashed bundles never change under the same name.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
