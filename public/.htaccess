# tayseerlaz.com on HostGator (Apache). Static Vite build, copied into public_html as-is.
Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# One canonical origin: https, no www.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://tayseerlaz.com%{REQUEST_URI} [R=301,L]

# Keep old project names pointing to the corresponding public page.
RewriteRule ^work/dyafa/?$ /work/ievents/ [R=301,L]
RewriteRule ^work/real-estate/?$ /work/bsheel/ [R=301,L]
RewriteRule ^work/(alinia|aligned-tech)/?$ https://aligned-tech.com/ [R=301,L]
RewriteRule ^work/?$ /#work [R=301,NE,L]

# Explicit index.html URLs resolve to the same canonical page as their directory.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# Apache serves the generated /work/<slug>/index.html directly.
# Unknown work slugs fall through to a genuine 404 rather than redirecting home.

# Missing paths use a dedicated error page and keep a real 404 status.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Always revalidate the page so a redeploy shows up immediately.
  <FilesMatch "\.(html|xml|txt|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Hashed bundles never change under the same name.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Images are not hashed, so a short cache: fast repeat visits, and a replaced image shows within a day.
  <If "%{REQUEST_URI} =~ m#^/images/#">
    Header set Cache-Control "public, max-age=86400"
  </If>
  # Browsers only honour HSTS on https responses, and every http request is redirected above.
  # No includeSubDomains, so other subdomains (mail, cPanel) keep working whatever their certificates.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
